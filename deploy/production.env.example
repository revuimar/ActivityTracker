# Copy to /opt/activitytracker/shared/.env ON THE VPS ONLY, chmod 600.
# Password must be a long random hex string (openssl rand -hex 32).
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost;127.0.0.1;your-domain.example
APP_BIND_IP=127.0.0.1
APP_PORT=8080
# Exact proxy IP as seen from the app container. No wildcard trust.
TRUSTED_PROXY_IP=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://your-domain.example/auth/strava/callback
# Generate on the VPS: openssl rand -hex 32. Keep the token private.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Fill after running deploy/register-strava-webhook.py on the VPS.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=0
# Recent history imported on connection/manual sync and reconciled daily (7–365 days).
STRAVA_IMPORT_DAYS=90
# Email/password testing requires HTTPS in production. No default credentials.
TEST_LOGIN_ENABLED=false
# Sign in, open /login, then set your displayed numeric account ID here.
# Do not use an email address as the administrator identity.
ADMIN_PARTICIPANT_ID=0
