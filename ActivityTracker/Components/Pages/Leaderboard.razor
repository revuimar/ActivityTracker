@page "/leaderboards/{Id:int}"
@inject IDbContextFactory<TrackerDb> DbFactory
@inject IConfiguration Config
@if (Board is null) { <h1>Leaderboard not found</h1><a href="/">Browse leaderboards</a> }
else {
    <a href="/">← All leaderboards</a>
    <h1>@Board.Name</h1><p>@Board.Description</p>
    <p class="muted">@Board.StartsOn.ToString("dd MMM yyyy") – @Board.EndsOn.ToString("dd MMM yyyy")</p>
    <div class="actions">
        @if (Context?.User.Identity?.IsAuthenticated == true) {
            <a class="button" href="/leaderboards/@Id/edit">Edit leaderboard</a>
        } else { <a href="/login">Log in to edit or appear in the rankings</a> }
        @if (Context is not null && Accounts.IsAdmin(Context.User, Config)) {
            <a href="/leaderboards/@Id/members">Manage participants</a>
        }
    </div>
    <div class="stats">
        <div class="tile"><span>Minimum workout</span><strong>@Board.MinimumMinutes min</strong></div>
        <div class="tile"><span>5 / 6 / 7 mornings</span><strong>+5 / +10 / +15</strong></div>
        <div class="tile"><span>Morning cutoff</span><strong>@Board.Cutoff.ToString("HH:mm")</strong></div>
    </div>
    <section>
        @if (Weeks is null) {
            <h2>Weekly leaderboard</h2>
            <p class="muted">This leaderboard starts on @Board.StartsOn.ToString("dd MMM yyyy"). Weekly rankings will appear once it begins.</p>
        } else {
            <div class="section-head"><h2>Weekly leaderboard</h2><span class="muted">@Monday.ToString("dd MMM") – @Monday.AddDays(6).ToString("dd MMM yyyy")</span></div>
            <nav class="week-navigation" aria-label="Leaderboard weeks">
                @if (Weeks.HasPrevious) {
                    <a href="@WeekUrl(Monday.AddDays(-7))" rel="prev">← Previous week</a>
                } else { <span class="muted" aria-disabled="true">← Previous week</span> }
                <span class="muted">Week @Weeks.Number of @Weeks.Count</span>
                @if (Weeks.HasNext) {
                    <a href="@WeekUrl(Monday.AddDays(7))" rel="next">Next week →</a>
                    <a href="/leaderboards/@Id">@(Weeks.LatestMonday == LeaderboardWeeks.MondayOf(Today) ? "Current week" : "Latest week")</a>
                } else { <span class="muted" aria-disabled="true">Next week →</span> }
            </nav>
            <p class="muted">Rankings use imported activities and the leaderboard's current rules and participants.</p>
            @if (Rows.Count == 0) { <p class="muted">No participants yet. Log in to join.</p> }
            else {
                <div class="table-wrap"><table><thead><tr><th>Rank</th><th>Athlete</th><th>Mornings</th><th>Workout</th><th>Bonus</th><th>Total</th></tr></thead>
                    <tbody>@for (var i = 0; i < Rows.Count; i++) {
                        var row = Rows[i];
                        <tr><td>@(i + 1)</td><td><b>@row.Name</b></td><td>@row.ActiveDays / 7</td><td>@row.WorkoutPoints</td><td>+@row.Bonus</td><td><strong>@row.Total</strong></td></tr>
                }</tbody></table></div>
            }
        }
    </section>
    <section aria-labelledby="monthly-heading">
        @if (Months is null) {
            <h2 id="monthly-heading">Monthly leaderboard</h2>
            <p class="muted">Monthly rankings will appear once this leaderboard begins.</p>
        } else {
            <div class="section-head"><h2 id="monthly-heading">Monthly leaderboard · @Months.SelectedMonth.ToString("MMMM yyyy")</h2><span class="muted">@Months.PeriodStart.ToString("dd MMM") – @Months.PeriodEnd.ToString("dd MMM yyyy")</span></div>
            <nav class="week-navigation" aria-label="Leaderboard months">
                @if (Months.HasPrevious) {
                    <a href="@MonthUrl(Months.SelectedMonth.AddMonths(-1))" rel="prev">← Previous month</a>
                } else { <span class="muted" aria-disabled="true">← Previous month</span> }
                @if (Months.HasNext) {
                    <a href="@MonthUrl(Months.SelectedMonth.AddMonths(1))" rel="next">Next month →</a>
                    <a href="@MonthUrl(Months.LatestMonth)">@(Months.LatestMonth == LeaderboardMonths.MonthOf(Today) ? "Current month" : "Latest month")</a>
                } else { <span class="muted" aria-disabled="true">Next month →</span> }
            </nav>
            <p class="muted">Daily workout points and weekly bonuses summed within this calendar month. Only days within the challenge dates count, including for bonuses in partial weeks.</p>
            @if (MonthlyRows.Count == 0) { <p class="muted">No participants yet. Log in to join.</p> }
            else {
                <div class="table-wrap"><table><thead><tr><th>Rank</th><th>Athlete</th><th>Mornings</th><th>Workout</th><th>Bonus</th><th>Total</th></tr></thead>
                    <tbody>@for (var i = 0; i < MonthlyRows.Count; i++) {
                        var row = MonthlyRows[i];
                        <tr><td>@(i + 1)</td><td><b>@row.Name</b></td><td>@row.ActiveDays / @Months.EligibleDays</td><td>@row.WorkoutPoints</td><td>+@row.Bonus</td><td><strong>@row.Total</strong></td></tr>
                    }</tbody></table></div>
            }
        }
    </section>
    <section><h2>How scoring works</h2><p>Qualifying workouts earn 5 points below 30 minutes, 6 points at 30–44 minutes, or 7 points at 45+ minutes. Only the best qualifying activity per day counts. Workouts must finish on the same day by @Board.Cutoff.ToString("HH:mm"), meet the @Board.MinimumMinutes-minute minimum, and fall within the leaderboard dates.</p><p>Monthly totals use the same rules across a calendar month and sum the existing weekly bonuses; there is no separate monthly bonus. Weeks spanning two months count only the days in the selected month toward its bonus.</p><p>Every account appears automatically, unless the app administrator removes it. Accounts without qualifying workouts show zero points. <a href="/strava">Connect Strava or check your activity sync.</a></p></section>
}
@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "week")] public string? Week { get; set; }
    [SupplyParameterFromQuery(Name = "month")] public string? Month { get; set; }
    [CascadingParameter] public HttpContext? Context { get; set; }
    private Challenge? Board;
    private List<ScoreRow> Rows = [];
    private List<ScoreRow> MonthlyRows = [];
    private LeaderboardWeeks? Weeks;
    private LeaderboardMonths? Months;
    private DateOnly Today;
    private DateOnly Monday => Weeks!.SelectedMonday;
    private string WeekUrl(DateOnly monday) => $"/leaderboards/{Id}?week={monday.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}";
    private string MonthUrl(DateOnly month) => $"{WeekUrl(Monday)}&month={month.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)}";
    protected override async Task OnParametersSetAsync() {
        await using var db = await DbFactory.CreateDbContextAsync();
        Board = await db.Challenges.AsNoTracking().SingleOrDefaultAsync(x => x.Id == Id);
        if (Board is null) { if (Context is not null) Context.Response.StatusCode = 404; return; }
        Today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("Europe/Warsaw")));
        Weeks = LeaderboardWeeks.Select(Board.StartsOn, Board.EndsOn, Today, Week);
        Rows = [];
        MonthlyRows = [];
        Months = null;
        if (Weeks is null) return;
        Months = LeaderboardMonths.Select(Board.StartsOn, Board.EndsOn, Today,
            string.IsNullOrWhiteSpace(Week) ? Today : Monday, Month);
        var start = Monday.ToDateTime(TimeOnly.MinValue);
        var end = start.AddDays(7);
        var monthStart = Months!.PeriodStart.ToDateTime(TimeOnly.MinValue);
        var monthEnd = Months.PeriodEnd.ToDateTime(TimeOnly.MinValue).AddDays(1);
        var people = await db.Participants.AsNoTracking()
            .Where(p => !db.LeaderboardExclusions.Any(e => e.ChallengeId == Id && e.ParticipantId == p.Id))
            .Select(p => new Participant { Id = p.Id, DisplayName = p.DisplayName,
                Activities = p.Activities.Where(a => (a.StartLocal >= start && a.StartLocal < end) ||
                    (a.StartLocal >= monthStart && a.StartLocal < monthEnd)).ToList() })
            .ToListAsync();
        Rows = Scoring.Weekly(people, Monday, Board.Cutoff, Board.MinimumMinutes, Board.StartsOn, Board.EndsOn);
        MonthlyRows = Scoring.Monthly(people, Months.SelectedMonth, Board.Cutoff, Board.MinimumMinutes, Board.StartsOn, Board.EndsOn);
    }
}
