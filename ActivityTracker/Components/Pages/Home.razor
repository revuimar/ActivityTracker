@page "/"
@inject IDbContextFactory<TrackerDb> DbFactory
<h1>Public leaderboards</h1>
<p class="muted">Everyone can follow along. Log in to create or edit a leaderboard and appear in the rankings.</p>
<div class="actions"><a class="button" href="/leaderboards/new">Create leaderboard</a><a href="/login">Log in or create an account</a></div>
@if (Boards is not null) {
    <div class="board-grid">
        @foreach (var board in Boards) {
            <section class="board-card">
                <h2><a href="/leaderboards/@board.Id">@board.Name</a></h2>
                <p>@board.Description</p>
                <p class="muted">@board.MinimumMinutes+ minutes · Complete by @board.Cutoff.ToString("HH:mm")</p>
                <a href="/leaderboards/@board.Id">View leaderboard →</a>
            </section>
        }
    </div>
    @if (Boards.Count == 0) { <p>No leaderboards yet. Log in to create the first one.</p> }
}
@code {
    private List<Challenge>? Boards;
    protected override async Task OnInitializedAsync() {
        await using var db = await DbFactory.CreateDbContextAsync();
        Boards = await db.Challenges.AsNoTracking().OrderBy(x => x.Id).ToListAsync();
    }
}
